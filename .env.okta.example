# Copy to .env.okta, replace example values, and protect the file (chmod 600).
GO_URL_HOSTS=go.example.com
APP_URI=https://go.example.com
POSTGRES_PASS=replace-with-a-long-random-database-password
SESSION_TOKEN=replace-with-a-long-random-session-signing-key
AUTH_PROVIDER=okta

# Okta OIDC Web Application
OKTA_CLIENT_ID=replace-with-the-client-id
OKTA_CLIENT_SECRET=replace-with-the-client-secret
OKTA_ISSUER=https://yourOktaDomain/oauth2/default
