# Copy to .env.ldap, replace example values, and protect the file (chmod 600).
GO_URL_HOSTS=go.example.com
APP_URI=https://go.example.com
POSTGRES_PASS=replace-with-a-long-random-database-password
SESSION_TOKEN=replace-with-a-long-random-session-signing-key

# LDAP server and service account
LDAP_URL=ldaps://ldap.example.com:636
LDAP_STARTTLS=false
LDAP_BIND_DN=cn=go-url,ou=services,dc=example,dc=com
LDAP_BIND_PASSWORD=replace-with-the-service-account-password
LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=com
LDAP_USER_FILTER=(&(objectClass=person)(uid={username}))
LDAP_USERNAME_ATTRIBUTE=uid

# Optional group restriction (remove all three settings to allow any LDAP user)
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com
LDAP_GROUP_FILTER=(&(objectClass=groupOfNames)(member={user_dn}))
LDAP_ALLOWED_GROUPS=cn=go-url,ou=groups,dc=example,dc=com

# Optional for a private CA; see docs/deployment/LDAP.md for the Compose mount.
#LDAP_CA_CERT_FILE=/etc/go-url/ldap-ca.pem
