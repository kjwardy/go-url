# Copy to .env.azure, replace example values, and protect the file (chmod 600).
GO_URL_HOSTS=go.example.com
APP_URI=https://go.example.com
POSTGRES_PASS=replace-with-a-long-random-database-password
SESSION_TOKEN=replace-with-a-long-random-session-signing-key
AUTH_PROVIDER=azure

# Microsoft Entra ID app registration
AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AD_CLIENT_SECRET=replace-with-the-client-secret-value
